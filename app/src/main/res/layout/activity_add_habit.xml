<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_marginTop="20sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/novo_h_bito"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/escolha_algo_que_voc_quer_tornar_parte_da_sua_rotina"
            android:textColor="#BDBDBD"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/nome_do_h_bito"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHabitName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#03DAC5"
            android:hint="@string/ex_estudar_android"
            android:inputType="textCapSentences"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8E8E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/categoria"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbStudy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/estudos"
                android:textColor="#FFFFFF"
                android:buttonTint="#BB86FC" />

            <RadioButton
                android:id="@+id/rbHealth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sa_de"
                android:textColor="#FFFFFF"
                android:buttonTint="#BB86FC" />

            <RadioButton
                android:id="@+id/rbProductivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lazer"
                android:textColor="#FFFFFF"
                android:buttonTint="#BB86FC" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/meta"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbDaily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/todos_os_dias"
                android:textColor="#FFFFFF"
                android:buttonTint="#03DAC5" />

            <RadioButton
                android:id="@+id/rbWeekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/de_seg_a_sex"
                android:textColor="#FFFFFF"
                android:buttonTint="#03DAC5" />

            <RadioButton
                android:id="@+id/rbTwoWeekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_2_vezes_por_semana"
                android:textColor="#FFFFFF"
                android:buttonTint="#03DAC5" />

            <RadioButton
                android:id="@+id/rbThreeWeekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_3_vezes_por_semana"
                android:textColor="#FFFFFF"
                android:buttonTint="#03DAC5" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dura_o_da_meta"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbDuration1Month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/_1_mes"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbDuration3Months"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_3_meses"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbDuration6Months"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_6_meses"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbDuration1Year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_1_ano"
                android:textColor="#FFFFFF" />

        </RadioGroup>

        <Button
            android:id="@+id/btnCreateHabit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/criar_h_bito"
            android:textColor="#121212"
            app:backgroundTint="#03DAC5" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4px"
            android:text="@string/voltar"
            android:textColor="#FFFFFF"
            app:backgroundTint="#3A3A3A" />

    </LinearLayout>

</ScrollView>